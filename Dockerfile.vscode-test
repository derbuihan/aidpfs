FROM golang:1.26-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg fuse3 ripgrep libgtk-3-0 libnss3 libx11-xcb1 \
    libxss1 libasound2 libgbm1 libxshmfence1 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libdrm2 libatk-bridge2.0-0 xvfb xauth python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/* \
  && echo 'user_allow_other' >> /etc/fuse.conf

RUN python3 -m venv /opt/oci \
  && /opt/oci/bin/pip install --no-cache-dir oci requests
ENV PATH="/opt/oci/bin:${PATH}"

WORKDIR /work
COPY go.mod go.sum ./
RUN go mod download

CMD ["bash"]
